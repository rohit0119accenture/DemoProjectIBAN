# =======================================================================
# Demo 02 — IBAN Validation — Agent Garage variant — Stack environment
#
# Copy to .env and fill in real values. Never commit .env.
# =======================================================================

# --- PostgreSQL (n8n backend) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- n8n ---
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=change-me-generate-random
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-generate-random

# --- Open WebUI bootstrap admin (only used on first run) ---
OWUI_ADMIN_EMAIL=admin@test.com
OWUI_ADMIN_PASSWORD=admin123

# --- n8n Webhook path used by the User Story Assistant pipe ---
# Must match the "path" field of the Webhook node inside workflow
# "6 - User Story Assistant with GitHub Integration".
N8N_WEBHOOK_PATH=880e3fd7-2418-4344-80e0-91f8305cab86

# --- LLM provider (used by n8n's Anthropic Chat Model node) ---
# Required: an Anthropic API key with access to Claude Sonnet 4.6 (or update the
# workflow to a different model).
ANTHROPIC_API_KEY=sk-ant-change-me

# --- OpenWebUI OpenAI-style base (rarely needed; default is fine) ---
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=dummy-not-used

# --- GitHub credential setup ---
# The workflow's "Create an issue" node needs a GitHub credential with `repo`
# scope (write access to the target repo). After first `docker compose up`,
# open http://localhost:5678 → Credentials → "New" → "GitHub API" and paste
# a Personal Access Token. Note the credential ID and update the workflow JSON
# at stack/n8n/backup/workflows/6_User_Story_Assistant_GitHub.json
# (replace REPLACE_WITH_GITHUB_CREDENTIAL_ID), then re-import:
#   docker compose up -d n8n-import
#
# Required PAT scopes: repo (Read + Write issues)
# Recommended: use a fine-grained PAT scoped to the demo repository only.
GITHUB_PAT_HINT_ONLY=ghp-create-on-github.com-and-paste-into-n8n
